{
  "name": "livedoc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "node scripts/git-hooks/install.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "deploy:check": "turbo run deploy:check",
    "licences": "pnpm --filter @livedoc/marketing licences",
    "bench:readers": "tsx scripts/read-bench.mts",
    "bench:stroke-points": "node --expose-gc --import ./scripts/ts-source-hooks.mjs scripts/stroke-points-bench.ts",
    "demo:sticky-vision:build": "node docs/demo/sticky-vision/build.mjs",
    "demo:sticky-vision": "pnpm demo:sticky-vision:build && node docs/demo/sticky-vision/serve.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "icons:vendor": "pnpm --filter @livedoc/icons vendor:lucide",
    "icons:sheet": "pnpm --filter @livedoc/live icons:sheet",
    "icons:brand": "pnpm --filter @livedoc/live icons:brand"
  },
  "devDependencies": {
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/prettier-config": "workspace:*",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.9",
    "smol-toml": "^1.9.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici": "^7.30.1",
      "js-yaml": "^4.3.0",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.9",
      "qs": "^6.16.1",
      "body-parser@2": "^2.4.0",
      "ip-address@10": "^10.7.4",
      "vite": "^7.3.7",
      "nanoid": "^3.3.18",
      "vitest": "^5.0.5",
      "@hono/node-server": "^2.0.5",
      "ws": "^8.21.0",
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@3 || 4 || 5": "^5.0.8",
      "onnxruntime-node>global-agent": "^4.1.3",
      "@tensorflow/tfjs>argparse": "^2.0.1"
    }
  }
}
