// Writes the next identity migration when better-auth wants schema the migrations do not have
// (docs/specs/014-identity/blueprints/auth-and-guest-access.md "Data and persistence").
//
//   bun scripts/identity-schema.mts <name>     e.g. `bun scripts/identity-schema.mts identity`
//
// Prints "in step" and writes nothing when there is nothing to add.
import { readdirSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { pendingIdentitySql } from '../src/auth/identity-schema';

const dir = fileURLToPath(new URL('../migrations/', import.meta.url));
const name = process.argv[2];
if (!name || !/^[a-z0-9_]+$/.test(name)) {
  console.error('usage: bun scripts/identity-schema.mts <snake_case_name>');
  process.exit(2);
}
const sql = await pendingIdentitySql(dir.replace(/\/$/, ''));
if (!sql) {
  console.log('identity schema: in step');
  process.exit(0);
}
const last = readdirSync(dir)
  .filter((f) => /^\d{4}_.*\.sql$/.test(f))
  .sort()
  .at(-1);
const next = String(Number(last!.slice(0, 4)) + 1).padStart(4, '0');
const file = `${dir}${next}_${name}.sql`;
writeFileSync(
  file,
  `-- Generated by scripts/identity-schema.mts from better-auth's options (src/auth/identity.ts); do not edit by hand.\n${sql}\n`,
);
console.log(`identity schema: wrote ${file}`);
