{
  "name": "@livedoc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var AI_ALLOWED_ORIGINS:",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@livedoc/api-schema": "workspace:*",
    "@livedoc/diagram-lint": "workspace:*",
    "@livedoc/document": "workspace:*",
    "@livedoc/document-views": "workspace:*",
    "@livedoc/edit-operations": "workspace:*",
    "@livedoc/explorer-lens": "workspace:*",
    "@livedoc/forms": "workspace:*",
    "@livedoc/icons": "workspace:*",
    "@livedoc/items": "workspace:*",
    "@livedoc/plan-art": "workspace:*",
    "@livedoc/render-png": "workspace:*",
    "@livedoc/sheets": "workspace:*",
    "@livedoc/templates": "workspace:*",
    "better-auth": "1.7.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  }
}
