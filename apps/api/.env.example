# API worker environment variables (docs/specs/002-project-scope/secrets-policy.md).
#
# This worker runs on Cloudflare Workers, not Node. Local dev reads
# these from `apps/api/.dev.vars` (gitignored, see wrangler docs);
# production reads them from `wrangler.toml` [vars] for plain
# strings, and from `wrangler secret put` for secrets. This file is
# a copy-paste reference for what the worker consults at runtime,
# committed to the repo so contributors have one place to look.
#
# Per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put real secret values
# in this file: hex / token shapes are placeholders only.

# Anonymous telemetry ingest + dashboard (docs/specs/017-telemetry/telemetry.md). Only the literal
# string "true" enables both. Unset / "false" / anything else keeps
# the events route accepting and dropping POSTs (204 with no D1
# write) and the dashboard route returning empty totals, so OSS
# self-host stays silent by default.
# TELEMETRY_ENABLED=true

# Shared secret marking a /api/events post as coming from one of our own
# workers over a service binding rather than the open internet (docs/specs/017-telemetry/telemetry.md).
# Those calls carry no CF-Connecting-IP, so without this they all collapse
# onto one 'anonymous' per-IP rate-limit key and throttle each other --
# which was silently dropping MCP telemetry. Set the SAME value on the mcp
# worker (`wrangler secret put INTERNAL_EVENTS_KEY` in both). Unset on
# either side = nobody is exempt, which is safe and needs no config, so a
# self-host can ignore this entirely.
# INTERNAL_EVENTS_KEY=<random string>

# The Community's off switch (docs/specs/025-community/community.md "Turning the Community off"). Set to false (or 0,
# off) to close every Community route and link and hide the Community from every app, without redeploying them:
# `wrangler secret put COMMUNITY_ENABLED` or a dashboard variable. Unset leaves it on.
# COMMUNITY_ENABLED=false

# OpenAI integration for the AI assistance feature (docs/specs/007-editor/ai-assistance.md).
# AI (docs/specs/007-editor/ai-assistance.md). The PROVIDER is inferred from which key you set — a key is
# provider-specific, so its name says whose it is. One key serves both AI
# features. Set both named keys to split them: the assistant (/api/ai) prefers
# OpenAI, the crop reader (/api/ai/read-notes) prefers Google, as on the hosted
# site. The generic AI_API_KEY is used only when neither named key is set.
# No key = the whole AI surface hides (capabilities reports aiEnabled:false,
# the routes answer 503).
#
# Google AI Studio:
# GOOGLE_AI_STUDIO_API_KEY=...
#
# OpenAI:
# OPENAI_API_KEY=sk-...
#
# Anything else that speaks the OpenAI wire (Mistral, OpenRouter, a local
# llama.cpp or Ollama) — needs the base URL and the model as well:
# AI_API_KEY=not-used-but-required
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_MODEL=whatever-you-loaded
#
# Optional for any provider:
# AI_MODEL=...          the assistant's model (default gemini-3.6-flash / gpt-4o);
#                       the reader follows it only on the same provider
# AI_VISION_MODEL=...   the crop reader's model (docs/specs/021-event-storming/event-storming.md Phase 8). On Google
#                       this defaults to gemini-2.5-flash-lite, which reads
#                       handwriting better than the assistant model and costs less.

# Optional spend-DoS defences on /api/ai (docs/specs/007-editor/ai-assistance.md). Both default to
# "off" so OSS self-hosters keep the historical open behaviour.
# Hosted livediagram.app sets both.
# AI_ALLOWED_ORIGINS=https://livediagram.app,http://localhost:3002
# AI_REQUIRE_ACCOUNT=true

# Optional per-owner soft caps on the image gallery (docs/specs/009-elements/images.md). Both
# decimal strings; unset / 0 / non-numeric = no limit. Hosted
# livediagram.app sets these to 100 and 104857600 (100 MB) so one
# owner can't drain the R2 bucket. POST /api/images returns 403
# { error: "gallery_full" } when either cap is hit.
# IMAGE_MAX_PER_OWNER=100
# IMAGE_MAX_BYTES_PER_OWNER=104857600

# Optional email (docs/specs/014-identity/transactional-email.md): the EMAIL send_email binding in wrangler.toml
# (Cloudflare Email Service), else RESEND_API_KEY, else none and email is inert. EMAIL_OUTBOX=1 keeps every message
# in the email_outbox table instead of sending it (previews, local sign-in), read back at
# GET /api/preview/outbox?to=<address>. EMAIL_FROM and APP_BASE_URL are optional [vars]
# (defaults "LiveDoc <hello@docs.nu>" and "https://docs.nu").
# RESEND_API_KEY=re_...
# EMAIL_OUTBOX=1
# EMAIL_FROM=LiveDoc <hello@docs.nu>
# APP_BASE_URL=http://localhost:3000

# Optional sign-in (docs/specs/014-identity/auth-and-guest-access.md). Unset = guest-only. With the secret, email
# codes need an email transport (above; EMAIL_OUTBOX=1 locally) and Google needs both GOOGLE_AUTH_* values.
# APP_BASE_URL must be the origin the browser uses (the router, http://localhost:3000, locally).
# The secret also derives the key that signs guest ids, so with it set every guest request on an owner-scoped
# route must carry its X-Owner-Sig; guests minted before the secret was set start afresh.
# Rotate with BETTER_AUTH_SECRETS="2:<new>,1:<old>" and keep BETTER_AUTH_SECRET in place: the guest key stays.
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# GOOGLE_AUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_AUTH_CLIENT_SECRET=...

# Google Drive mirror (docs/specs/022-drive-mirror/drive-mirror.md, "Self-hosting").
# Optional. All unset = no Drive entry anywhere and every /api/drive route
# answers 503 drive_not_configured.
#
# GOOGLE_CLIENT_ID switches the feature on: the OAuth client id of YOUR Google
# Cloud project (a plain var; the live app needs the same value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). With it alone, the browser holds short-lived
# tokens and asks for a click ("Resume sync") when one lapses.
# GOOGLE_CLIENT_ID=123456789012-abc.apps.googleusercontent.com
#
# Add both of these to broker refresh tokens, so the mirror keeps syncing
# without clicks. Both are secrets: `wrangler secret put <NAME>` in
# production, `apps/api/.dev.vars` locally. DRIVE_TOKEN_KEY is base64 of 32
# random bytes (`openssl rand -base64 32`); it seals the stored refresh tokens,
# so changing it turns every connection into "Needs reconnecting".
# GOOGLE_CLIENT_SECRET=...
# DRIVE_TOKEN_KEY=...
#
# Tests only: where the token exchange and revoke go instead of
# https://oauth2.googleapis.com (the e2e suite's fake Google). Never set this
# on a real deployment.
# GOOGLE_OAUTH_BASE_URL=http://127.0.0.1:8790
#
# The live build id (docs/specs/016-platform/stale-builds.md): the deploy's commit, the same value
# as the editor build's NEXT_PUBLIC_BUILD_ID. The deploy workflow sets both; unset leaves it off
# the server release signal (an open editor then never treats itself as stale).
# BUILD_ID=
