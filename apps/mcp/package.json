{
  "name": "@livedoc/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --inspector-port 9230",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage"
  },
  "dependencies": {
    "@livedoc/agent-verbs": "workspace:*",
    "@livedoc/api-client": "workspace:*",
    "@livedoc/api-schema": "workspace:*",
    "@livedoc/diagram-lint": "workspace:*",
    "@livedoc/document": "workspace:*",
    "@livedoc/edit-operations": "workspace:*",
    "@livedoc/forms": "workspace:*",
    "@livedoc/icons": "workspace:*",
    "@livedoc/items": "workspace:*",
    "@livedoc/plan-art": "workspace:*",
    "@livedoc/render-png": "workspace:*",
    "@livedoc/sheets": "workspace:*",
    "@livedoc/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  }
}
