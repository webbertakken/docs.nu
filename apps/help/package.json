{
  "name": "@livedoc/help",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 4004",
    "build": "next build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
