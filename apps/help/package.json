    "@livedoc/telemetry-client": "workspace:*",
    "@livedoc/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.4.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@livedoc/next-config": "workspace:*",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/tailwind-config": "workspace:*",
    "@livedoc/templates": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
