{
  "name": "@livedoc/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "dev": "wrangler dev --env local --port 4000 --inspector-port 9231",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livedoc/api-schema": "workspace:*",
    "@livedoc/help-registry": "workspace:*",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
